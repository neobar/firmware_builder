diff --git a/target/linux/airoha/an7581/base-files/lib/upgrade/platform.sh b/target/linux/airoha/an7581/base-files/lib/upgrade/platform.sh
index d8cf5e2586159a..4e1c5ba25c439d 100644
--- a/target/linux/airoha/an7581/base-files/lib/upgrade/platform.sh
+++ b/target/linux/airoha/an7581/base-files/lib/upgrade/platform.sh
@@ -1,7 +1,94 @@
-RAMFS_COPY_BIN='fitblk fit_check_sign'
+RAMFS_COPY_BIN='fitblk fit_check_sign tr'
 
 REQUIRE_IMAGE_METADATA=1
 
+gemtek_factory_valid() {
+	local vol="$1"
+	local off mac
+
+	[ "$(hexdump -v -n 2 -e '2/1 "%02x"' "$vol")" = "9079" ] || return 1
+
+	for off in 0x5000 0x6000; do
+		mac="$(hexdump -v -s $((off)) -n 6 -e '6/1 "%02x"' "$vol")"
+		case "$mac" in
+		000000000000|ffffffffffff|?[13579bdf]*)
+			return 1
+			;;
+		esac
+	done
+}
+
+gemtek_mac_bytes() {
+	printf "$(echo "$1" | sed 's/^/\\x/;s/:/\\x/g')"
+}
+
+# The factory volume (MT7996 EEPROM and the MAC addresses) is built from the
+# vendor partition, which the install leaves untouched. Rebuild it when it is
+# missing or empty, as after the chainloader formatted the ubi partition.
+gemtek_prepare_factory() {
+	local ubidev vol mtd dsd ebs off eeprom wan lan fan serial mac
+	local blob="/tmp/factory.bin"
+
+	ubidev="$(nand_find_ubi ubi)" || return 0
+	vol="$(nand_find_volume "$ubidev" factory)"
+	[ -n "$vol" ] && gemtek_factory_valid "/dev/$vol" && return 0
+
+	mtd="$(find_mtd_index vendor)"
+	[ -n "$mtd" ] || return 0
+	mtd="/dev/mtd$mtd"
+
+	dsd="$(dd if="$mtd" bs=4096 skip=$((0x400000 / 4096)) count=1 2>/dev/null | tr -c ' -~' '\n')"
+	wan="$(echo "$dsd" | sed -n '/^wan_mac=/{s///p;q}')"
+	lan="$(echo "$dsd" | sed -n '/^lan_mac=/{s///p;q}')"
+	fan="$(echo "$dsd" | sed -n '/^fan_id=/{s///p;q}')"
+	serial="$(echo "$dsd" | sed -n '/^serial_number=/{s///p;q}')"
+
+	case "$serial" in
+	XR1710G*) ;;
+	*)
+		v "factory: serial number '$serial' does not match, not rebuilding"
+		return 0
+		;;
+	esac
+
+	for mac in "$wan" "$lan"; do
+		echo "$mac" | grep -qE '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$' || {
+			v "factory: invalid MAC '$mac' in the vendor partition, not rebuilding"
+			return 0
+		}
+	done
+
+	# The EEPROM is in the first good block from 0x405000.
+	ebs="$(cat /sys/class/mtd/${mtd#/dev/}/erasesize)"
+	for off in 0 1 2 3; do
+		off=$((0x405000 + off * ebs))
+		[ "$(hexdump -v -s "$off" -n 2 -e '2/1 "%02x"' "$mtd")" = "9079" ] && {
+			eeprom="$off"
+			break
+		}
+	done
+	[ -n "$eeprom" ] || {
+		v "factory: no EEPROM in the vendor partition, not rebuilding"
+		return 0
+	}
+
+	dd if=/dev/zero of="$blob" bs=4096 count=16 2>/dev/null
+	dd if="$mtd" bs=512 skip=$((eeprom / 512)) count=15 2>/dev/null | \
+		dd of="$blob" conv=notrunc 2>/dev/null
+	gemtek_mac_bytes "$wan" | dd of="$blob" bs=4096 seek=5 conv=notrunc 2>/dev/null
+	gemtek_mac_bytes "$lan" | dd of="$blob" bs=4096 seek=6 conv=notrunc 2>/dev/null
+	printf '%s' "$fan" | dd of="$blob" bs=4096 seek=7 conv=notrunc 2>/dev/null
+	printf '%s' "$serial" | dd of="$blob" bs=4096 seek=8 conv=notrunc 2>/dev/null
+
+	[ -n "$vol" ] || {
+		ubimkvol "/dev/$ubidev" -N factory -t static -s $((0x10000)) && \
+			vol="$(nand_find_volume "$ubidev" factory)"
+	}
+	[ -n "$vol" ] && ubiupdatevol "/dev/$vol" "$blob" && \
+		v "factory: rebuilt from the vendor partition (WAN $wan, LAN $lan)"
+	rm -f "$blob"
+}
+
 nokia_initial_setup()
 {
 	[ "$(rootfs_type)" = "tmpfs" ] || return 0
@@ -15,15 +102,16 @@ platform_check_image() {
 	[ "$#" -gt 1 ] && return 1
 
 	case "$board" in
-	nokia,xg-040g-md)
-		nand_do_platform_check "$board" "$1"
-		return $?
-		;;
+	gemtek,xr1710g-ubi|\
 	nokia,xg-040g-md-ubi|\
 	quantum,q1000k-ubi)
 		fit_check_image "$1"
 		return $?
 		;;
+	nokia,xg-040g-md)
+		nand_do_platform_check "$board" "$1"
+		return $?
+		;;
 	esac
 
 	return 0
@@ -38,6 +126,10 @@ platform_do_upgrade() {
 		quantum,q1000k-ubi)
 			fit_do_upgrade "$1"
 			;;
+		gemtek,xr1710g-ubi)
+			gemtek_prepare_factory
+			fit_do_upgrade "$1"
+			;;
 		*)
 			nand_do_upgrade "$1"
 			;;
diff --git a/target/linux/airoha/dts/an7581-gemtek_xr1710g-ubi.dts b/target/linux/airoha/dts/an7581-gemtek_xr1710g-ubi.dts
new file mode 100644
index 00000000000000..4457cf9a9a3bdc
--- /dev/null
+++ b/target/linux/airoha/dts/an7581-gemtek_xr1710g-ubi.dts
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "an7581-gemtek-common.dtsi"
+
+/ {
+	model = "Gemtek XR1710G (UBI)";
+	compatible = "gemtek,xr1710g-ubi", "airoha,an7581", "airoha,en7581";
+
+	aliases {
+		label-mac-device = &gdm2;
+	};
+};
+
+&en7581_pinctrl {
+	/* The lan3/lan4 LEDs are driven by the internal switch PHYs */
+	gswp1_led0_pins: gswp1-led0-pins {
+		mux {
+			function = "phy1_led0";
+			pins = "gpio33";
+		};
+	};
+
+	gswp1_led1_pins: gswp1-led1-pins {
+		mux {
+			function = "phy1_led1";
+			pins = "gpio43";
+		};
+	};
+
+	gswp2_led0_pins: gswp2-led0-pins {
+		mux {
+			function = "phy2_led0";
+			pins = "gpio34";
+		};
+	};
+
+	gswp2_led1_pins: gswp2-led1-pins {
+		mux {
+			function = "phy2_led1";
+			pins = "gpio44";
+		};
+	};
+};
+
+&gsw_phy1 {
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gswp1_led0_pins>, <&gswp1_led1_pins>;
+};
+
+&gsw_phy1_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <3>;
+	active-low;
+};
+
+&gsw_phy1_led1 {
+	status = "okay";
+	color = <LED_COLOR_ID_AMBER>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <3>;
+	active-low;
+};
+
+&gsw_phy2 {
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gswp2_led0_pins>, <&gswp2_led1_pins>;
+};
+
+&gsw_phy2_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <4>;
+	active-low;
+};
+
+&gsw_phy2_led1 {
+	status = "okay";
+	color = <LED_COLOR_ID_AMBER>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <4>;
+	active-low;
+};
diff --git a/target/linux/airoha/image/an7581.mk b/target/linux/airoha/image/an7581.mk
index bf5962abaac104..14c723900da120 100644
--- a/target/linux/airoha/image/an7581.mk
+++ b/target/linux/airoha/image/an7581.mk
@@ -106,6 +106,35 @@ define Device/gemtek_w1700k-ubi
 endef
 TARGET_DEVICES += gemtek_w1700k-ubi
 
+define Device/gemtek_xr1710g-ubi
+  DEVICE_VENDOR := Gemtek
+  DEVICE_MODEL := XR1710G
+  DEVICE_VARIANT := (UBI)
+  DEVICE_ALT0_VENDOR := Brightspeed
+  DEVICE_ALT0_MODEL := XR1710G
+  DEVICE_ALT0_VARIANT := (UBI)
+  DEVICE_DTS := an7581-gemtek_xr1710g-ubi
+  DEVICE_PACKAGES := airoha-en7581-mt7996-npu-firmware fitblk \
+		    kmod-hwmon-nct7802 kmod-mt7996-firmware wpad-basic-mbedtls \
+		    rtl826x-firmware
+  UBINIZE_OPTS := -E 5
+  BLOCKSIZE := 128k
+  PAGESIZE := 2048
+  UBOOTENV_IN_UBI := 1
+  KERNEL_IN_UBI := 1
+  KERNEL := kernel-bin | gzip
+  KERNEL_INITRAMFS := kernel-bin | lzma | \
+	fit lzma $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb with-initrd | pad-to 128k
+  KERNEL_INITRAMFS_SUFFIX := -recovery.itb
+  IMAGES := sysupgrade.itb
+  IMAGE/sysupgrade.itb := append-kernel | \
+	fit gzip $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb external-static-with-rootfs | append-metadata
+  ARTIFACTS := chainload-uboot.itb
+  ARTIFACT/chainload-uboot.itb := an7581-chainloader gemtek_xr1710g
+  SOC := an7581
+endef
+TARGET_DEVICES += gemtek_xr1710g-ubi
+
 define Device/nokia_valyrian
   DEVICE_VENDOR := Nokia
   DEVICE_MODEL := Valyrian
